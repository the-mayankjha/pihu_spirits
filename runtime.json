{
  "schema_version": 1,
  "cell": { "width": 192, "height": 208 },
  "sheet": { "width": 1536, "heights": [1872, 2288] },
  "animations": [
    { "id": "idle", "label": "Idle", "row": 0, "frames": 6, "fps": 6 },
    { "id": "running-right", "label": "Running right", "row": 1, "frames": 8, "fps": 10 },
    { "id": "running-left", "label": "Running left", "row": 2, "frames": 8, "fps": 10 },
    { "id": "waving", "label": "Waving", "row": 3, "frames": 4, "fps": 7 },
    { "id": "jumping", "label": "Jumping", "row": 4, "frames": 5, "fps": 7 },
    { "id": "failed", "label": "Failed", "row": 5, "frames": 8, "fps": 7 },
    { "id": "waiting", "label": "Waiting", "row": 6, "frames": 6, "fps": 6 },
    { "id": "running", "label": "Focused work", "row": 7, "frames": 6, "fps": 7 },
    { "id": "review", "label": "Review", "row": 8, "frames": 6, "fps": 6 }
  ],
  "special_poses": [
    { "id": "cat-play", "source": "running", "row": 7, "frames": 6, "fps": 4 },
    { "id": "hair-flip", "source": "review", "row": 8, "frames": 6, "fps": 6 },
    { "id": "speaking", "row": 3, "frames": 8, "fps": 10, "assets": "talking_frames" },
    { "id": "listening", "row": 0, "frames": 16, "fps": 8, "assets": "listening_frames" },
    { "id": "thinking", "source": "running", "row": 7, "frames": 6, "fps": 6 }
  ],
  "state_mapping": {
    "idle": "idle", "sleeping": "idle", "wake": "waving", "listening": "waiting",
    "thinking": "running", "executing": "running", "speaking": "review", "review": "review",
    "waiting": "waiting", "success": "jumping", "error": "failed"
  },
  "activity_rules": [
    { "when": "agent or orb state is error", "animation": "failed" },
    { "when": "voice is speaking or orb state is speaking", "animation": "speaking" },
    { "when": "agent is thinking or executing", "animation": "running" },
    { "when": "processing", "animation": "running" },
    { "when": "approval is pending", "animation": "review when reviewing, otherwise waiting" },
    { "when": "agent reports success", "animation": "jumping" },
    { "when": "no active work", "animation": "idle" }
  ],
  "idle_rules": [
    { "after_ms": 12000, "duration_ms": 1000, "animation": "hair-flip" },
    { "after_ms": 20000, "animation": "cat-play" },
    { "condition": "cursor moves at least 24 px", "animation": "look direction; 16 directions across atlas rows 9 and 10" }
  ],
  "interactions": [
    "talking", "high-five", "handshake", "hug", "fight", "looking", "cheek-touch", "laughing", "smiling",
    "jealous", "turning", "mediating", "reconcile"
  ],
  "social_timing_ms": { "gaze": 1000, "approach": 4000, "action": 6800, "cooldown": 1000 }
}
