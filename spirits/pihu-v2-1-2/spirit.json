{
  "schema_version": 1,
  "type": "spirits",
  "id": "pihu-v2-1-2",
  "name": "pihu-v2-1-2",
  "display_name": "Pihu_v2",
  "description": "Pihu_v2 with idle performances, expressive speech, listening transitions, and browser-work animations.",
  "version": "1.4.2",
  "deprecated": false,
  "author": "Mayank Jha (PIHU)",
  "category": "Spirits",
  "tags": [
    "companion",
    "pihu_v2",
    "directional-animation"
  ],
  "assets": {
    "sprite_sheet": "spritesheet-extended.png",
    "listening_state": "states/listening.png",
    "talking_frames": "final/tts-visemes/"
  },
  "supported_features": [
    "sprite-animation",
    "look-directions",
    "listening",
    "visemes",
    "idle-animations",
    "expressive-talking",
    "listening-transition",
    "browser-automation"
  ],
  "animations": {
    "idle_guitar": {
      "path": "animations/idle/guitar.png",
      "frames": 6,
      "fps": 6,
      "trigger": "idle"
    },
    "idle_sitting": {
      "path": "animations/idle/sitting.png",
      "frames": 6,
      "fps": 6,
      "trigger": "browser-mcp-entry-and-exit",
      "segments": {
        "browser_sit_down": {
          "start_frame": 0,
          "frames": 4
        },
        "cat_stand_up": {
          "start_frame": 4,
          "frames": 2
        },
        "browser_stand_up": {
          "start_frame": 3,
          "frames": 3
        }
      }
    },
    "idle_butterfly": {
      "path": "animations/idle/butterfly.png",
      "frames": 6,
      "fps": 6,
      "trigger": "idle"
    },
    "idle_hairflip": {
      "path": "animations/idle/hairflip.png",
      "frames": 6,
      "fps": 6,
      "trigger": "idle",
      "segments": {
        "single_pass": {
          "start_frame": 0,
          "frames": 6,
          "loop": false
        },
        "repeat_after_guitar": {
          "after_idle_ms": 33000,
          "frames": 6,
          "loop": false
        }
      }
    },
    "idle_pouting": {
      "path": "animations/idle/pouting.png",
      "frames": 6,
      "fps": 6,
      "trigger": "idle"
    },
    "talking": {
      "path": "animations/talking/talking.png",
      "frames": 8,
      "fps": 10,
      "trigger": "speaking"
    },
    "talking_expressive": {
      "path": "animations/talking/expressive.png",
      "frames": 8,
      "fps": 8,
      "trigger": "speaking"
    },
    "headphones_transition": {
      "path": "animations/listening/headphones-transition.png",
      "frames": 8,
      "fps": 10,
      "trigger": "listening-entry-and-exit",
      "segments": {
        "put_on": {
          "start_frame": 0,
          "frames": 5
        },
        "take_off": {
          "start_frame": 5,
          "frames": 3
        }
      }
    },
    "focused_listening": {
      "path": "animations/listening/focused.png",
      "frames": 6,
      "fps": 6,
      "trigger": "listening"
    },
    "browser_automation": {
      "path": "animations/browser/automation.png",
      "frames": 8,
      "fps": 8,
      "trigger": "pihu-web-search-mcp"
    },
    "browser_automation_enhanced": {
      "path": "animations/browser/automation-enhanced.png",
      "frames": 8,
      "fps": 8,
      "trigger": "playwright-mcp"
    }
  }
}
